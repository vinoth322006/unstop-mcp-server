# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# --- Required for HTTP deployments -----------------------------------------
# Encrypts stored Unstop sessions. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
UNSTOP_MCP_SECRET_KEY=

# Public URL clients use (behind your TLS proxy). Also added to the Host allow-list.
# UNSTOP_MCP_PUBLIC_URL=https://mcp.example.com

# --- Transport -------------------------------------------------------------
# UNSTOP_MCP_TRANSPORT=stdio          # stdio | http
# UNSTOP_MCP_HOST=127.0.0.1
# UNSTOP_MCP_PORT=8000
# UNSTOP_MCP_PATH=/mcp
# UNSTOP_MCP_ALLOWED_HOSTS=mcp.example.com
# UNSTOP_MCP_ALLOWED_ORIGINS=https://mcp.example.com

# --- Storage ---------------------------------------------------------------
# UNSTOP_MCP_DATA_DIR=~/.unstop-mcp

# --- Upstream politeness ---------------------------------------------------
# UNSTOP_MCP_RATE_LIMIT_PER_SECOND=4
# UNSTOP_MCP_RATE_LIMIT_BURST=8
# UNSTOP_MCP_CACHE_TTL_SECONDS=300
# UNSTOP_MCP_TIMEOUT_SECONDS=20
# UNSTOP_MCP_MAX_RETRIES=3

# --- Behaviour -------------------------------------------------------------
# UNSTOP_MCP_ENABLE_WRITE_TOOLS=true   # false hides add/remove_from_watchlist
# UNSTOP_MCP_LOG_LEVEL=INFO
# UNSTOP_MCP_LOG_JSON=true

# Single-user shortcut: paste an Unstop access token instead of `unstop-mcp login`
# (no auto-refresh; prefer login).
# UNSTOP_MCP_ACCESS_TOKEN=
